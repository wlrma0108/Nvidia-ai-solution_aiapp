{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: 디버그 모드",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "카메라 Detection: 디버그",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: 현재 파일 디버그",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "OCR Detection 테스트",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/DrugDetection.py",
      "args": [
        "coffee.jpg"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
